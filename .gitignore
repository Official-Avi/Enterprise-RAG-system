# Secrets and local config
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
apps/web/next-env.d.ts
*.tsbuildinfo
playwright-report/
test-results/

# Local runtime data (databases, uploaded files, model caches)
.data/
var/
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local secrets kept in Docs/ (never commit)
Docs/env
Docs/demo-password.txt
Docs/env.example
Docs/MEMORY.md
Docs/feedback-*.md
Docs/project-*.md
Docs/reference-*.md

# Any other secret-like files, anywhere
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.dump
*password*.txt
*secret*.txt
credentials*.json

# Local screenshots/mockups
/public/*.png
!/public/image.png
