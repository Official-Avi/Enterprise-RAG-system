# RackFlow AI — example configuration. Copy to `.env` and fill local values.
# Never commit `.env`. Secrets belong in environment variables or a secret manager.
#
# APP_ENV=production refuses to start on unsafe values. The error names the variable, never its
# value. The production rules are marked [production] below; development and test skip them:
#   COOKIE_SECURE=true, DEMO_MODE=false, EMBEDDING_PROVIDER not `hash`, plus every rule below.

APP_ENV=development                  # development | test | production
API_BASE_URL=http://127.0.0.1:8000   # public API URL. [production] must be https://
# Allowed CORS origin, comma-separated for several. [production] must be set, all https://
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO                       # [production] DEBUG and NOTSET are refused (they log request detail)

# PostgreSQL (metadata + durable job queue)
# [production] refused: no or empty password, the development password `rackflow`, a password
# equal to the user name, or a password shorter than 16 characters. URL-encode special characters.
DATABASE_URL=postgresql+psycopg://rackflow:rackflow@127.0.0.1:5432/rackflow

# Qdrant vector store
# [production] VECTOR_STORE_URL must be http:// or https://. A host that is not private (loopback,
# a private IP, `localhost`, a single-label name such as the Compose service `qdrant`, or a name
# ending in .internal, .local, .lan, .home.arpa, .svc or .cluster.local) must use https:// and set
# VECTOR_STORE_API_KEY. The check reads the configured name only; it does not resolve DNS.
VECTOR_STORE_URL=http://127.0.0.1:6333
VECTOR_STORE_API_KEY=                # optional on a private network; required for a remote Qdrant
VECTOR_COLLECTION=rackflow_chunks

# Object storage: `local` (filesystem) in development. S3-compatible adapter is future work.
OBJECT_STORAGE_MODE=local
OBJECT_STORAGE_PATH=.data/objects
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=

# Chat model provider: extractive | anthropic | openai_compatible
#   extractive        = no LLM; quotes retrieved evidence (development/CI fallback, clearly labelled)
#   anthropic         = hosted Claude API (requires MODEL_API_KEY)
#   openai_compatible = any OpenAI-compatible endpoint, e.g. local Ollama at http://localhost:11434/v1
#                       (requires MODEL_BASE_URL and MODEL_NAME)
# [production] anthropic needs MODEL_API_KEY. openai_compatible needs MODEL_API_KEY and an https://
#              MODEL_BASE_URL unless MODEL_BASE_URL is a private address (a self-hosted model; same
#              definition of private as VECTOR_STORE_URL above).
MODEL_PROVIDER=extractive
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=                       # placeholder only — never commit a real value
MODEL_TIMEOUT_SECONDS=60             # at most 600. [production] must be below WEB_PROXY_TIMEOUT_SECONDS
# How long the web container's /api proxy waits for the API, in seconds. It must equal the web's
# API_PROXY_TIMEOUT_MS / 1000 (proxyTimeout in apps/web/next.config.ts; 120 s by default). The API
# cannot see the web's value, so keep the two in step. [production] MODEL_TIMEOUT_SECONDS must be
# below it, so a slow answer fails in the API with a clear error instead of at the proxy. Leave a
# margin: the anthropic client retries once, and retrieval adds its own time.
WEB_PROXY_TIMEOUT_SECONDS=120
MODEL_MAX_CONCURRENCY=4

# Embeddings: fastembed (local ONNX, no document egress) | hash (deterministic, TEST ONLY)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Ingestion
UPLOAD_MAX_BYTES=26214400            # 25 MiB
UPLOAD_MAX_PAGES=500
OCR_ENABLED=true
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60

# Retrieval
RETRIEVAL_TOP_K=6
RETRIEVAL_SCORE_THRESHOLD=0.45

# Jobs / workers
JOB_MAX_ATTEMPTS=4
JOB_LEASE_SECONDS=120
WORKER_POLL_INTERVAL_SECONDS=1.0

# Authentication (local accounts + server-side sessions; see DECISIONS.md ADR-006)
SESSION_TTL_HOURS=12
COOKIE_SECURE=false                  # must be true behind HTTPS in staging/production
AUTH_ISSUER=                         # reserved for a future OIDC provider

# One-click demo personas on the landing page (seeded acme users). Refused when APP_ENV=production.
DEMO_MODE=false

# Proxies allowed to state the client's address in X-Forwarded-For, as comma-separated IPs or CIDR
# ranges. Empty (the default) trusts nobody: rate limits use the connecting address. Everyone behind
# a proxy then shares one limit, so list your proxy, and only proxies clients cannot bypass. The proxy
# must set X-Forwarded-For itself; a client sending the header directly is ignored. For Compose
# behind a load balancer, see the notes at the top of docker-compose.yml.
TRUSTED_PROXY_IPS=
