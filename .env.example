# RackFlow AI — example configuration. Copy to `.env` and fill local values.
# Never commit `.env`. Secrets belong in environment variables or a secret manager.

APP_ENV=development                  # development | test | production
API_BASE_URL=http://127.0.0.1:8000
WEB_ORIGIN=http://localhost:3000     # allowed CORS origin (comma-separated for several)
LOG_LEVEL=INFO

# PostgreSQL (metadata + durable job queue)
DATABASE_URL=postgresql+psycopg://rackflow:rackflow@127.0.0.1:5432/rackflow

# Qdrant vector store
VECTOR_STORE_URL=http://127.0.0.1:6333
VECTOR_STORE_API_KEY=                # optional; required when Qdrant auth is enabled
VECTOR_COLLECTION=rackflow_chunks

# Object storage: `local` (filesystem) in development. S3-compatible adapter is future work.
OBJECT_STORAGE_MODE=local
OBJECT_STORAGE_PATH=.data/objects
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=

# Chat model provider: extractive | anthropic | openai_compatible
#   extractive        = no LLM; quotes retrieved evidence (development/CI fallback, clearly labelled)
#   anthropic         = hosted Claude API (requires MODEL_API_KEY)
#   openai_compatible = any OpenAI-compatible endpoint, e.g. local Ollama at http://localhost:11434/v1
MODEL_PROVIDER=extractive
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=                       # placeholder only — never commit a real value
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_CONCURRENCY=4

# Embeddings: fastembed (local ONNX, no document egress) | hash (deterministic, TEST ONLY)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Ingestion
UPLOAD_MAX_BYTES=26214400            # 25 MiB
UPLOAD_MAX_PAGES=500
OCR_ENABLED=true
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60

# Retrieval
RETRIEVAL_TOP_K=6
RETRIEVAL_SCORE_THRESHOLD=0.45

# Jobs / workers
JOB_MAX_ATTEMPTS=4
JOB_LEASE_SECONDS=120
WORKER_POLL_INTERVAL_SECONDS=1.0

# Authentication (local accounts + server-side sessions; see DECISIONS.md ADR-006)
SESSION_TTL_HOURS=12
COOKIE_SECURE=false                  # must be true behind HTTPS in staging/production
AUTH_ISSUER=                         # reserved for a future OIDC provider
