# RackFlow AI — production environment reference. Contains NO real values.
#
# Do not copy this file by hand. Generate the real one, with fresh secrets and mode 600:
#   python scripts/ops/generate_env.py --output .env --domain rag.example.com --tls-issuer ops@example.com
# then fill what it lists as "Still to fill in". Never commit the result.
#
# Compose reads `.env` next to docker-compose.yml. Containers receive only the variables listed in
# docker-compose.yml (x-backend-env and each service's environment); deploy/compose.prod.yml then
# fixes APP_ENV, COOKIE_SECURE, DEMO_MODE, WEB_ORIGIN, API_BASE_URL, DATABASE_URL and
# TRUSTED_PROXY_IPS for the backend services, whatever this file says. The values below still
# matter for anything that reads the file directly (the backend's own settings loader, and
# scripts/ops/backup.py and restore.py run on the host).
#
# With APP_ENV=production the API refuses to start on an unsafe value; the error names the variable,
# never its value. Rules marked [production] come from backend/src/rackflow/core/config.py.
# "<...>" marks a value you supply; "<generated>" one generate_env.py creates.

# ---- Mode -----------------------------------------------------------------------------------------
APP_ENV=production                    # development | test | production
COOKIE_SECURE=true                    # [production] must be true
DEMO_MODE=false                       # [production] must be false (one-click demo personas)
LOG_LEVEL=INFO                        # [production] DEBUG and NOTSET are refused

# ---- Public address (Caddy, TLS) --------------------------------------------------------------------
DOMAIN=<public host name, e.g. rag.example.com>   # one name, no scheme/port/path; Caddy serves it
WEB_ORIGIN=https://<DOMAIN>           # allowed CORS origin(s), comma-separated. [production] set, all https://
API_BASE_URL=https://<DOMAIN>         # public API URL. [production] must be https://
TLS_ISSUER=<ops@example.com>          # ACME contact e-mail, or `internal` (Caddy's own CA, test hosts only)
CADDY_UPSTREAM_TIMEOUT=180s           # Caddy's wait for web's response headers; keep above API_PROXY_TIMEOUT_MS

# ---- PostgreSQL ---------------------------------------------------------------------------------
# POSTGRES_PASSWORD initialises the database on the volume's first start only; changing it later
# does not change the password inside Postgres. Generated values are URL-safe; a hand-chosen one
# must be URL-encoded inside DATABASE_URL.
POSTGRES_PASSWORD=<generated>
# [production] refused: no password, `rackflow`, the user name, or fewer than 16 characters.
# Host `postgres` is the Compose service; scripts run on the host need a reachable host instead.
DATABASE_URL=postgresql+psycopg://rackflow:<POSTGRES_PASSWORD>@postgres:5432/rackflow

# ---- Qdrant -------------------------------------------------------------------------------------
# [production] a host that is not private (loopback, private IP, `localhost`, a single-label name
# such as `qdrant`, or .internal/.local/.lan/.home.arpa/.svc/.cluster.local) needs https:// and
# VECTOR_STORE_API_KEY.
VECTOR_STORE_URL=http://qdrant:6333
VECTOR_STORE_API_KEY=<generated>      # the key the API and the ops scripts send to Qdrant
QDRANT__SERVICE__API_KEY=<generated>  # the key the Qdrant server requires; must equal VECTOR_STORE_API_KEY
VECTOR_COLLECTION=rackflow_chunks

# ---- Chat model ---------------------------------------------------------------------------------
# extractive: no model, quotes retrieved passages (no egress). anthropic: hosted Claude API.
# openai_compatible: any OpenAI-compatible endpoint (e.g. a self-hosted model).
# [production] anthropic needs MODEL_API_KEY. openai_compatible needs MODEL_NAME and MODEL_BASE_URL,
# plus MODEL_API_KEY and an https:// URL unless MODEL_BASE_URL is a private address.
MODEL_PROVIDER=extractive
MODEL_NAME=                           # <model id> for anthropic / openai_compatible
MODEL_BASE_URL=                       # <https://...> for openai_compatible
MODEL_API_KEY=                        # <secret from your model provider>; never commit it
MODEL_TIMEOUT_SECONDS=60              # at most 600. [production] must be below WEB_PROXY_TIMEOUT_SECONDS
MODEL_MAX_CONCURRENCY=4               # not passed to containers by docker-compose.yml today

# ---- Web /api proxy timeout (keep the three in step) --------------------------------------------
WEB_PROXY_TIMEOUT_SECONDS=120         # what the API assumes the web proxy waits
API_PROXY_TIMEOUT_MS=120000           # the web proxy's timeout (build argument + runtime); = WEB_PROXY_TIMEOUT_SECONDS * 1000

# ---- Embeddings ---------------------------------------------------------------------------------
EMBEDDING_PROVIDER=fastembed          # [production] `hash` is refused (test only)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Client addresses ---------------------------------------------------------------------------
# Proxies trusted to state the client address in X-Forwarded-For. The production overlay fixes this
# to web and Caddy; never add the gateway, the subnet or 0.0.0.0/0 (see deploy/README.md).
TRUSTED_PROXY_IPS=172.30.0.10,172.30.0.11

# ---- First admin (one-off; not stored here) -----------------------------------------------------
# Production has no demo accounts. After the stack is up, create each tenant's first org_admin:
#   rackflow-admin bootstrap-admin --tenant <slug> --tenant-name "<name>" --email <email> \
#       [--password-env RACKFLOW_ADMIN_PASSWORD]
# RACKFLOW_ADMIN_PASSWORD is read from the shell for that one command (if unset, a password is
# generated and shown once). Do not keep it in this file. seed-demo and seed-eval refuse to run with
# APP_ENV=production unless given --allow-in-production.
# RACKFLOW_ADMIN_PASSWORD=

# ---- Other app settings (defaults shown; docker-compose.yml does not pass them to containers) ----
# OBJECT_STORAGE_MODE=local
# OBJECT_STORAGE_PATH=.data/objects
# UPLOAD_MAX_BYTES=26214400
# UPLOAD_MAX_PAGES=500
# OCR_ENABLED=true
# CHUNK_SIZE_TOKENS=400
# CHUNK_OVERLAP_TOKENS=60
# RETRIEVAL_TOP_K=6
# RETRIEVAL_SCORE_THRESHOLD=0.45
# JOB_MAX_ATTEMPTS=4
# JOB_LEASE_SECONDS=120
# WORKER_POLL_INTERVAL_SECONDS=1.0
# SESSION_TTL_HOURS=12
# AUTH_ISSUER=
